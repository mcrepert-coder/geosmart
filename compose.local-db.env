# Lu apres .env, seulement avec compose.local-db.yaml. compose.yaml exige ces deux
# variables ; avec la base locale, compose.local-db.yaml remplace l'adresse de la base
# et retire le certificat Aiven. Aucun secret ici.
DATABASE_URL=remplacee-par-compose.local-db.yaml
AIVEN_CA_CERT_PATH=inutile-avec-la-base-locale
