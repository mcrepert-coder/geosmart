# Remplacer les secrets avant de lancer Docker Compose.
# Utiliser un mot de passe PostgreSQL aleatoire URL-safe (lettres, chiffres, - ou _).
DATABASE_URL=postgresql://avnadmin:REMPLACER_PAR_LE_MOT_DE_PASSE@pg-ea64de8-kanleto83-b6b0.a.aivencloud.com:17126/defaultdb?sslmode=verify-full
AIVEN_CA_CERT_PATH=C:/chemin/vers/ca.pem
# Ces trois valeurs servent uniquement au profil optionnel de base locale (local-db).
POSTGRES_DB=geosmart
POSTGRES_USER=geosmart
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
JWT_SECRET=replace-with-a-long-random-secret
DB_PORT=5433
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=false
API_INTERNAL_URL=http://backend:3001
WEB_ORIGIN=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# Requetes admises par minute et par adresse IP (les routes /auth ont des limites plus strictes).
THROTTLE_LIMIT=300
# Utilisees uniquement lors du bootstrap initial du Super Admin.
ADMIN_PHONE=replace-with-admin-phone
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-random-password
