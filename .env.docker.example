# Remplacer les secrets avant de lancer Docker Compose.
# Utiliser un mot de passe PostgreSQL aleatoire URL-safe (lettres, chiffres, - ou _).
POSTGRES_DB=geosmart
POSTGRES_USER=geosmart
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
JWT_SECRET=replace-with-a-long-random-secret
DB_PORT=5433
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=false
API_INTERNAL_URL=http://backend:3001
# Utilisees uniquement lors du bootstrap initial du Super Admin.
ADMIN_PHONE=replace-with-admin-phone
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-random-password
