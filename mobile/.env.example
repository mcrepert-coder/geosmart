# Copier ce fichier en .env et remplacer les valeurs.
# Le .env local est ignore par Git.
#
# Emulateur Android : 10.0.2.2 pointe vers la machine hote.
# Telephone physique : utiliser l'adresse IP locale de la machine.
#
# Lancer l'application avec :
#   flutter run --dart-define-from-file=.env

# Serveur de synchronisation des missions (POST /sync).
GEOSMART_API_BASE_URL=http://10.0.2.2:3001

# Adresse de l'API publique (GET /parcels/:id/status).
API_BASE_URL=http://10.0.2.2:3001

# Caster NTRIP.
NTRIP_HOST=replace-with-caster-host
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=replace-with-mountpoint
NTRIP_USERNAME=replace-me
NTRIP_PASSWORD=replace-me
