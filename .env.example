# Copier ce fichier en .env et remplacer les valeurs. Ne jamais commiter le .env.
# Mot de passe Aiven; encoder en URL les caracteres speciaux.
DATABASE_URL=postgresql://avnadmin:REMPLACER_PAR_LE_MOT_DE_PASSE@pg-ea64de8-kanleto83-b6b0.a.aivencloud.com:17126/defaultdb?sslmode=verify-full
AIVEN_CA_CERT_PATH=C:/chemin/vers/ca.pem
JWT_SECRET=CHANGER_MOI_PAR_UNE_LONGUE_CHAINE_ALEATOIRE
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=30
PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=false
LAND_OVERLAP_TOLERANCE_M2=0
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
SMS_PROVIDER=log
# Used only by the one-time admin-bootstrap Compose profile; never passed to the API service.
ADMIN_PHONE=replace-with-admin-phone
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password
